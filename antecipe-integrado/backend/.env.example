# Taxa de desconto mensal em fração: 0.02 significa 2% ao mês.
# Ajuste para a taxa real usada pela operação antes de usar em produção.
ANTECIPE_TAXA_MENSAL=0.02

# Origens permitidas para chamadas do frontend (separadas por vírgula).
# Em produção, substitua * pelo domínio real do frontend.
ANTECIPE_CORS=*

# Opcional: data fixa apenas para testes/demonstração.
# ANTECIPE_HOJE=2026-10-24
